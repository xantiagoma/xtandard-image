# Copy to .env next to the compose file and fill in. Never commit the real file.
# Image: <version>-slim (stills), -full (video, detection; LGPL FFmpeg), -gpl (H.264/HEVC; GPL).
XI_IMAGE=ghcr.io/xantiagoma/xtandard-image:0.1.1-slim
# compose.split.yml: the video fleet needs full or gpl.
VIDEO_IMAGE=ghcr.io/xantiagoma/xtandard-image:0.1.1-full
# openssl rand -hex 32 (each). Comma-separated lists rotate keys.
XI_SIGNING_KEYS=replace-with-hex
XI_SIGNING_SALTS=replace-with-hex
# Seals HLS/DASH child URLs; the same value on every video instance (openssl rand -hex 32).
XI_VIDEO_TRANSFORM_STREAM_KEYS=replace-with-hex
XI_SOURCES_WEB_ALLOW=images.example.com
PUBLISH_PORT=8080
