{
  "role": "image",
  "image": { "flavor": "slim", "tag": "" },
  "existingSecret": "xi-signing",
  "config": {
    "XI_SOURCES": "origin",
    "XI_SOURCES_ORIGIN_TYPE": "http",
    "XI_SOURCES_ORIGIN_ALLOW": "images.example.com",
    "XI_CACHE_RESULT_STORES": "memory"
  },
  "resources": {
    "requests": { "cpu": "2", "memory": "1Gi" },
    "limits": { "cpu": "2", "memory": "2Gi" }
  },
  "autoscaling": { "enabled": true, "type": "hpa", "minReplicas": 2, "maxReplicas": 20 }
}
