;; GIMP 2.10 batch script of testdata/gen/designer.sh: the XCF fixtures
;; (layers.xcf, gray.xcf, alpha.xcf) and GIMP's flattened renders of them,
;; from the CC0 photo and logo fixtures mounted at /fx.

(define (save-flat image path)
  (let* ((dup (car (gimp-image-duplicate image)))
         (flat (car (gimp-image-merge-visible-layers dup CLIP-TO-IMAGE))))
    (file-png-save2 RUN-NONINTERACTIVE dup flat path path 0 9 0 0 0 0 0 0 0)))

(let* ((image (car (gimp-file-load RUN-NONINTERACTIVE "/fx/baseline.jpg" "baseline.jpg")))
       (bg (car (gimp-image-get-active-layer image))))
  (gimp-image-scale image 160 120)
  (gimp-item-set-name bg "photo")
  (let* ((logo (car (gimp-file-load-layer RUN-NONINTERACTIVE image "/fx/logo.png")))
         (hidden (car (gimp-file-load-layer RUN-NONINTERACTIVE image "/fx/logo.png")))
         (mult (car (gimp-file-load-layer RUN-NONINTERACTIVE image "/fx/logo.png")))
         (group (car (gimp-layer-group-new image)))
         (child (car (gimp-file-load-layer RUN-NONINTERACTIVE image "/fx/logo.png"))))
    (gimp-image-insert-layer image logo 0 0)
    (gimp-item-set-name logo "logo 70%")
    (gimp-layer-set-offsets logo 60 40)
    (gimp-layer-set-opacity logo 70)
    (gimp-image-insert-layer image mult 0 0)
    (gimp-item-set-name mult "logo multiply")
    (gimp-layer-set-offsets mult 100 8)
    (gimp-layer-set-mode mult LAYER-MODE-MULTIPLY)
    (gimp-image-insert-layer image group 0 0)
    (gimp-item-set-name group "group")
    (gimp-image-insert-layer image child group 0)
    (gimp-item-set-name child "child")
    (gimp-layer-set-offsets child 10 70)
    (gimp-image-insert-layer image hidden 0 0)
    (gimp-item-set-name hidden "hidden")
    (gimp-layer-set-offsets hidden 4 4)
    (gimp-item-set-visible hidden FALSE)
    (gimp-xcf-save 0 image bg "/fx/layers.xcf" "layers.xcf")
    (save-flat image "/fx/layers-flat.png")
    (gimp-image-convert-grayscale image)
    (gimp-xcf-save 0 image bg "/fx/gray.xcf" "gray.xcf")
    (save-flat image "/fx/gray-flat.png")))

(let* ((image (car (gimp-image-new 64 48 RGB)))
       (logo (car (gimp-file-load-layer RUN-NONINTERACTIVE image "/fx/logo.png"))))
  (gimp-image-insert-layer image logo 0 0)
  (gimp-layer-set-offsets logo 8 8)
  (gimp-xcf-save 0 image logo "/fx/alpha.xcf" "alpha.xcf")
  (save-flat image "/fx/alpha-flat.png"))

(gimp-quit 0)
