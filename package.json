{
  "name": "xtandard-image-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "bun run --filter './packages/*' generate",
    "generate:check": "bun run --filter './packages/*' generate:check",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "build": "bun run --filter './packages/*' build",
    "licenses": "bun scripts/check-ts-licenses.ts"
  }
}
