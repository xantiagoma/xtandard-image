# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Build artifacts
/build/
/tmp/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.*
!.env.example
/.refs/

# Downloaded test inputs (internal/testutil/rawfixtures)
/testdata/cache/

# TypeScript workspace (clients/typescript and packages/*, ADR 0009, ADR 0013)
node_modules/
clients/typescript/dist/
packages/*/dist/
*.tsbuildinfo
clients/typescript/LICENSE
packages/*/LICENSE

# Official clients (clients/*, ADR 0013)
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
clients/*/dist/

# SwiftPM at the repository root (Package.swift publishes clients/swift, ADR 0013).
# A library does not commit Package.resolved; the client's own tasks build in clients/swift/.build.
/Package.resolved
/.build/
/.swiftpm/

# deploy/ tooling (WP-149): check caches, Terraform/OpenTofu state and lock files, Node tooling
/deploy/.cache/
/deploy/terraform/*/.terraform/
/deploy/terraform/*/.terraform.lock.hcl
/deploy/terraform/*/terraform.tfstate*
/deploy/*/cdk.out/
/deploy/sst/.sst/

# Orchestration notes and helper scripts (local only, not part of the project)
/.orchestration/
