+/* xtandard-image: text is character data, escaped. Metafile strings are in
+ * a Windows code page, not UTF-8: bytes from 0x80 are written as the Latin-1
+ * character of that value (exact for ISO-8859-1, close for Windows-1252),
+ * and control characters XML forbids are dropped. */
+static void svg_text_escaped (wmfAPI* API,wmfStream* out,const char* str)
+{	const unsigned char* p;
+
+	if (str == 0) return;
+
+	for (p = (const unsigned char*) str; *p; p++)
+	{	switch (*p)
+		{
+		case '&': wmf_stream_printf (API,out,"&amp;"); break;
+		case '<': wmf_stream_printf (API,out,"&lt;"); break;
+		case '>': wmf_stream_printf (API,out,"&gt;"); break;
+		default:
+			if (*p >= 0x80) wmf_stream_printf (API,out,"&#x%X;",(unsigned int) *p);
+			else if (*p >= 0x20 || *p == '\t' || *p == '\n' || *p == '\r')
+				wmf_stream_printf (API,out,"%c",(int) *p);
+			break;
+		}
+	}
+}
