<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED "">
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED "" domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKENS #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  xtandard-image ImageMagick security policy (WP-66, docs/FORMATS.md).

  Installed at /opt/xtandard/etc/ImageMagick-7/policy.xml by docker/base/build-deps.sh.
  ImageMagick is in the base image for one reason: libvips' magickload for PSD/PSB.
  Every other coder, every delegate, every filter and every indirect read is denied,
  so a file that reaches the magick loader in any other format fails instead of being
  decoded by one of ImageMagick's many built-in coders. Later rules override earlier
  ones, so the deny-all rules come first.

  Resource limits are ceilings: MAGICK_* environment variables and the API can only
  lower them, never raise them.
-->
<policymap>
  <!-- Resources. vips runs one worker thread per image (concurrency 1). -->
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="time" value="10"/>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="256MiB"/>
  <policy domain="resource" name="disk" value="0"/>
  <policy domain="resource" name="area" value="64MP"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="list-length" value="128"/>
  <policy domain="resource" name="file" value="64"/>
  <policy domain="system" name="max-memory-request" value="256MiB"/>
  <policy domain="system" name="memory-map" value="anonymous"/>
  <policy domain="cache" name="memory-map" value="anonymous"/>

  <!-- No external programs, no filters, no indirect or special paths. -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="path" rights="none" pattern="-"/>
  <policy domain="path" rights="none" pattern="[Ff][Dd]:*"/>
  <policy domain="path" rights="none" pattern="|*"/>

  <!-- Coders: deny all, then allow reading PSD and PSB only (no writing). A module
       (the PSD module registers both the PSD and PSB coders) needs "read | write" to
       be registered at all; the coder rules below then restrict it to reading. Denied
       modules are never registered, so their coders do not exist in the process. -->
  <policy domain="module" rights="none" pattern="*"/>
  <policy domain="module" rights="read | write" pattern="PSD"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{PSD,PSB}"/>
</policymap>
