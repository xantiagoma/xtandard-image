    ?wmt: video_watermark_text_value?,
    ?wmu: video_watermark_url_value?
  }

  # Every video option name and alias.
  type video_option_name = "ab" | "ac" | "ach" | "att" | "audio_bitrate" | "audio_channels" | "audio_codec" | "background" | "bc" | "bg" | "bypass_cache" | "c" | "cache_tags" | "cachebuster" | "cb" | "crf" | "crop" | "ct" | "duration" | "el" | "end" | "enlarge" | "ex" | "exp" | "expires" | "ext" | "extend" | "f" | "fade" | "fd" | "filename" | "fl" | "flip" | "fn" | "format" | "fps" | "g" | "gravity" | "h" | "hashsum" | "height" | "hs" | "keyframe_interval" | "ki" | "ln" | "loudnorm" | "mu" | "mute" | "of" | "overlay_fade" | "overlay_window" | "ow" | "pr" | "preset" | "q" | "quality" | "raw" | "resize" | "resizing_type" | "return_attachment" | "rot" | "rotate" | "rs" | "rt" | "s" | "sample_rate" | "segment_duration" | "segment_format" | "sgd" | "sgf" | "size" | "sr" | "st" | "start" | "stream" | "tc" | "timecode" | "vb" | "vc" | "vd" | "ve" | "video_bitrate" | "video_codec" | "vol" | "volume" | "vs" | "w" | "watermark" | "watermark_rotate" | "watermark_shadow" | "watermark_size" | "watermark_text" | "watermark_url" | "waveform" | "wf" | "width" | "wm" | "wm_rot" | "wmr" | "wms" | "wmsh" | "wmt" | "wmu"

  VIDEO_NAMES: Hash[String, String]
  VIDEO_SHORT: Hash[String, String]
end
