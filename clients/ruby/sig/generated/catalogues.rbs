  type video_watermark_args = [Integer | Float] | [Integer | Float, ("ce" | "no" | "so" | "ea" | "we" | "noea" | "nowe" | "soea" | "sowe" | "re" | "ch" | :"ce" | :"no" | :"so" | :"ea" | :"we" | :"noea" | :"nowe" | :"soea" | :"sowe" | :"re" | :"ch")?] | [Integer | Float, ("ce" | "no" | "so" | "ea" | "we" | "noea" | "nowe" | "soea" | "sowe" | "re" | "ch" | :"ce" | :"no" | :"so" | :"ea" | :"we" | :"noea" | :"nowe" | :"soea" | :"sowe" | :"re" | :"ch")?, (Integer | Float)?] | [Integer | Float, ("ce" | "no" | "so" | "ea" | "we" | "noea" | "nowe" | "soea" | "sowe" | "re" | "ch" | :"ce" | :"no" | :"so" | :"ea" | :"we" | :"noea" | :"nowe" | :"soea" | :"sowe" | :"re" | :"ch")?, (Integer | Float)?, (Integer | Float)?] | [Integer | Float, ("ce" | "no" | "so" | "ea" | "we" | "noea" | "nowe" | "soea" | "sowe" | "re" | "ch" | :"ce" | :"no" | :"so" | :"ea" | :"we" | :"noea" | :"nowe" | :"soea" | :"sowe" | :"re" | :"ch")?, (Integer | Float)?, (Integer | Float)?, (Integer | Float)?]
  type video_watermark_value = video_watermark_args | Integer | Float
  # Argument lists of video option `watermark_rotate`.
  type video_watermark_rotate_args = [Integer | Float]
  type video_watermark_rotate_value = video_watermark_rotate_args | Integer | Float
  # Argument lists of video option `watermark_shadow`.
  type video_watermark_shadow_args = [Integer | Float]
  type video_watermark_shadow_value = video_watermark_shadow_args | Integer | Float
  # Argument lists of video option `watermark_size`.
  type video_watermark_size_args = [Integer?] | [Integer?, Integer?]
  type video_watermark_size_value = video_watermark_size_args | Integer
  # Argument lists of video option `watermark_text`.
  type video_watermark_text_args = [String?]
  type video_watermark_text_value = video_watermark_text_args | String
  # Argument lists of video option `watermark_url`.
  type video_watermark_url_args = [String?]
  type video_watermark_url_value = video_watermark_url_args | String
  # Argument lists of video option `waveform`.
  type video_waveform_args = [bool?] | [bool?, String?] | [bool?, String?, String?] | [bool?, String?, String?, bool?]
  type video_waveform_value = video_waveform_args | bool
  # Argument lists of video option `width`.
  type video_width_args = [Integer]
  type video_width_value = video_width_args | Integer

  # video options of one pipeline, keyed by name or alias (symbols), in URL order.
  # A value is the argument list, or the first argument alone when the rest are
  # optional: { rs: ["fill", 300, 400], q: 80 }. nil inside a list is an empty
  # argument; a nil value skips the option. String keys work at run time too.
  type video_options = {
    ?ab: video_audio_bitrate_value?,
    ?ac: video_audio_codec_value?,
    ?ach: video_audio_channels_value?,
    ?att: video_return_attachment_value?,
    ?audio_bitrate: video_audio_bitrate_value?,
    ?audio_channels: video_audio_channels_value?,
    ?audio_codec: video_audio_codec_value?,
    ?background: video_background_value?,
    ?bc: video_bypass_cache_value?,
    ?bg: video_background_value?,
    ?bypass_cache: video_bypass_cache_value?,
    ?c: video_crop_value?,
    ?cache_tags: video_cache_tags_value?,
    ?cachebuster: video_cachebuster_value?,
    ?cb: video_cachebuster_value?,
    ?crf: video_crf_value?,
    ?crop: video_crop_value?,
    ?ct: video_cache_tags_value?,
    ?duration: video_duration_value?,
    ?el: video_enlarge_value?,
    ?end: video_end_value?,
    ?enlarge: video_enlarge_value?,
    ?ex: video_extend_value?,
    ?exp: video_expires_value?,
    ?expires: video_expires_value?,
    ?ext: video_format_value?,
    ?extend: video_extend_value?,
    ?f: video_format_value?,
    ?fade: video_fade_value?,
    ?fd: video_fade_value?,
    ?filename: video_filename_value?,
    ?fl: video_flip_value?,
    ?flip: video_flip_value?,
    ?fn: video_filename_value?,
    ?format: video_format_value?,
    ?fps: video_fps_value?,
    ?g: video_gravity_value?,
    ?gravity: video_gravity_value?,
    ?h: video_height_value?,
    ?hashsum: video_hashsum_value?,
    ?height: video_height_value?,
    ?hs: video_hashsum_value?,
    ?keyframe_interval: video_keyframe_interval_value?,
    ?ki: video_keyframe_interval_value?,
    ?ln: video_loudnorm_value?,
    ?loudnorm: video_loudnorm_value?,
    ?mu: video_mute_value?,
    ?mute: video_mute_value?,
    ?of: video_overlay_fade_value?,
    ?overlay_fade: video_overlay_fade_value?,
    ?overlay_window: video_overlay_window_value?,
    ?ow: video_overlay_window_value?,
    ?pr: video_preset_value?,
    ?preset: video_preset_value?,
    ?q: video_quality_value?,
    ?quality: video_quality_value?,
    ?raw: video_raw_value?,
    ?resize: video_resize_value?,
    ?resizing_type: video_resizing_type_value?,
    ?return_attachment: video_return_attachment_value?,
    ?rot: video_rotate_value?,
    ?rotate: video_rotate_value?,
    ?rs: video_resize_value?,
    ?rt: video_resizing_type_value?,
    ?s: video_size_value?,
    ?sample_rate: video_sample_rate_value?,
    ?segment_duration: video_segment_duration_value?,
    ?segment_format: video_segment_format_value?,
    ?sgd: video_segment_duration_value?,
    ?sgf: video_segment_format_value?,
    ?size: video_size_value?,
    ?sr: video_sample_rate_value?,
    ?st: video_stream_value?,
    ?start: video_start_value?,
    ?stream: video_stream_value?,
    ?tc: video_timecode_value?,
    ?timecode: video_timecode_value?,
    ?vb: video_video_bitrate_value?,
    ?vc: video_video_codec_value?,
    ?vd: video_duration_value?,
    ?ve: video_end_value?,
    ?video_bitrate: video_video_bitrate_value?,
    ?video_codec: video_video_codec_value?,
    ?vol: video_volume_value?,
    ?volume: video_volume_value?,
    ?vs: video_start_value?,
    ?w: video_width_value?,
    ?watermark: video_watermark_value?,
    ?watermark_rotate: video_watermark_rotate_value?,
    ?watermark_shadow: video_watermark_shadow_value?,
    ?watermark_size: video_watermark_size_value?,
    ?watermark_text: video_watermark_text_value?,
    ?watermark_url: video_watermark_url_value?,
    ?waveform: video_waveform_value?,
    ?wf: video_waveform_value?,
    ?width: video_width_value?,
    ?wm: video_watermark_value?,
    ?wm_rot: video_watermark_rotate_value?,
    ?wmr: video_watermark_rotate_value?,
