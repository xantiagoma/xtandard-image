// ErrorKindFor returns the error kind of a plain-text error response: the kind whose status and
// public message match (the server writes the message alone when Accept does not list JSON).
func ErrorKindFor(status int, message string) (ErrorKind, bool) {
	switch {
	case status == 400 && message == "invalid url":
		return ErrorKindInvalidURL, true
	case status == 403 && message == "invalid signature":
		return ErrorKindUnauthorized, true
	case status == 403 && message == "forbidden":
		return ErrorKindForbidden, true
	case status == 404 && message == "url expired":
		return ErrorKindExpired, true
	case status == 404 && message == "source image not found":
		return ErrorKindNotFound, true
	case status == 422 && message == "source image too large":
		return ErrorKindSourceTooLarge, true
	case status == 422 && message == "image exceeds processing limits":
		return ErrorKindLimitExceeded, true
	case status == 422 && message == "unsupported image format":
		return ErrorKindUnsupported, true
	case status == 422 && message == "image cannot be decoded":
		return ErrorKindCorrupt, true
	case status == 422 && message == "source hash mismatch":
		return ErrorKindHashMismatch, true
	case status == 406 && message == "no acceptable image format":
		return ErrorKindNotAcceptable, true
	case status == 502 && message == "upstream error":
		return ErrorKindUpstreamError, true
	case status == 504 && message == "upstream timeout":
		return ErrorKindUpstreamTimeout, true
	case status == 429 && message == "too many requests":
		return ErrorKindOverloaded, true
	case status == 503 && message == "service unavailable":
		return ErrorKindUnavailable, true
	case status == 504 && message == "processing timeout":
		return ErrorKindTimeout, true
	case status == 499 && message == "request canceled":
		return ErrorKindCanceled, true
	case status == 500 && message == "internal server error":
		return ErrorKindInternal, true
	}
	return ErrorKindUnknown, false
}

